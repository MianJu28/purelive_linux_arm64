+         */
+        p->EGLImageTargetTexture2DOES =
+            (void *)eglGetProcAddress("glEGLImageTargetTexture2DOES");
     }
 
     if (!p->CreateImageKHR || !p->DestroyImageKHR ||
@@ -351,10 +365,23 @@ bool dmabuf_interop_gl_init(const struct ra_hwdec *hw,
         return false;
 
     GL *gl = ra_gl_get(hw->ra_ctx->ra);
-    const char *imageext = gl->es ? "GL_OES_EGL_image" : "GL_EXT_EGL_image_storage";
+    /*
+     * A desktop GL stack may import dmabufs through GL_EXT_EGL_image_storage or
+     * through GL_OES_EGL_image. The storage route is preferred (it is the
+     * extension designed for it) but the OES route is accepted as well: Jingjia
+     * JM9100 resolves glEGLImageTargetTexStorageEXT while omitting the storage
+     * extension string, and only its OES entry binds the imported surface.
+     */
+    const bool has_storage =
+        gl_check_extension(gl->extensions, "GL_EXT_EGL_image_storage");
+    const bool has_oes = gl_check_extension(gl->extensions, "GL_OES_EGL_image");
+    const char *imageext = "GL_OES_EGL_image";
+    if (!gl->es) {
+        imageext = has_storage ? "GL_EXT_EGL_image_storage" : "GL_OES_EGL_image";
+    }
     if (!gl_check_extension(exts, "EGL_EXT_image_dma_buf_import") ||
         !gl_check_extension(exts, "EGL_KHR_image_base") ||
-        !gl_check_extension(gl->extensions, imageext) ||
+        !(gl->es ? has_oes : (has_storage || has_oes)) ||
         !(gl->mpgl_caps & MPGL_CAP_TEX_RG)) {
         return false;
     }
